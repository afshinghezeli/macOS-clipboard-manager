<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sandboxed, with no network, file or hardware entitlements (ADR 0002).
       Every key added here widens what Spindle can do; ask before adding one. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Read access to files and folders the user picks in an open panel, and nothing else: the
       Maccy folder to import, and apps to add to the ignore list. -->
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
</dict>
</plist>
